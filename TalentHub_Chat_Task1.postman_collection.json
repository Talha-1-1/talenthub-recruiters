{
  "info": {
    "_postman_id": "9b12a845-6677-4488-8888-talenthubtask1",
    "name": "TalentHub Recruiters - Task 1 Auth API",
    "description": "Postman Collection for testing TalentHub Recruiters Real-time Support Chat Task 1 (JWT Authentication & Skeleton).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "response": []
    },
    {
      "name": "1. Register Candidate",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('authToken', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Muhammad Talha Ayub\",\n  \"email\": \"talha@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"candidate\",\n  \"title\": \"Full Stack MERN Developer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "2. Register Agent",
      "request": {
        "method": "POST",
        "header": [
