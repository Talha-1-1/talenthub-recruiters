            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sarah Jenkins\",\n  \"email\": \"sarah.agent@talenthub.com\",\n  \"password\": \"Recruiter2026!\",\n  \"role\": \"agent\",\n  \"title\": \"Senior Technical Recruiter\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
