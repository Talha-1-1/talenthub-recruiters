# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/talenthub_chat?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/talenthub_chat
MONGO_URI=mongodb://127.0.0.1:27017/talenthub_chat

# JWT Configuration
JWT_SECRET=talenthub_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRE=7d
